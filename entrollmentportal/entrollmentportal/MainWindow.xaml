<Window x:Class="entrollmentportal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:entrollmentportal"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="800">
    <Grid>
        <!--header-->
       <TextBlock Text="University of Chennai" FontSize="20" Foreground="CadetBlue" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"></TextBlock>
   
       <!--Content-->
        <Border Background="#AFD2F8"  Padding="20" Margin="0,40,0,0" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">

            <TabControl Background="AliceBlue">
                <!--Tab for login Form-->
                <TabItem Header="Login" Background="CadetBlue" Foreground="Black" FontSize="10" Width="225" FontWeight="Bold" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Login" FontSize="20" FontWeight="Bold" Foreground="CadetBlue" HorizontalAlignment="Center" Margin="0,0,0,20"></TextBlock>

                        <TextBlock Text="User" x:Name="txtuser" Margin="10" FontSize="12"></TextBlock>
                        <!--user type dropdown-->
                        <ComboBox Width="300" x:Name="cmbloginrole"  Height="35" Margin="0,0,10,20">
                            <ComboBoxItem Content="Staff"></ComboBoxItem>
                            <ComboBoxItem Content="Student"></ComboBoxItem>
                        </ComboBox>
                       <!--Password-->
                        <TextBlock Text="Password" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <PasswordBox x:Name="pwpassword" Margin="0,0,10,20" Height="35" Width="300"  ></PasswordBox>
                       <!--Confirm password-->
                        <TextBlock Text="Confirm Password" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <PasswordBox x:Name="pwcpassword" Margin="0,0,10,20" Height="35" Width="300"  ></PasswordBox>
                       <!-- submit Button-->
                        <Button Content="Login" x:Name="btnlogin" Click="btnlogin_Click" Margin="0,0,10,20" Height="35" Width="100" Foreground="Black" Background="CadetBlue"></Button>
                      <!--Switch Account-->
                        <TextBlock Text="Don't have an account ? click here to Register" FontSize="10" Margin="110,0,0,10"  Foreground="Gray"></TextBlock>

                    </StackPanel>
                </TabItem>
                <TabItem Header="Register" Background="CadetBlue" Foreground="Black" FontSize="10"  FontWeight="Bold" Padding="10" HorizontalAlignment="Left" Width="230">
                    <StackPanel>
                        <TextBlock Text="Registration" FontSize="20" FontWeight="Bold" Foreground="CadetBlue" HorizontalAlignment="Center" Margin="0,0,0,20"></TextBlock>
                        <TextBlock Text="User" Margin="10" FontSize="12"></TextBlock>
                        <!--user type dropdown-->
                        <ComboBox x:Name="cmbrole" Width="300" Height="35" Margin="0,0,10,20">
                            <ComboBoxItem Content="Staff"></ComboBoxItem>
                            <ComboBoxItem Content="Student"></ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="User Name" Margin="10" FontSize="12"></TextBlock>
                        <TextBox x:Name="txtusername" Width="300" Height="35" Margin="0,0,10,20"></TextBox>
                       <!--password for registration-->
                        <TextBlock Text="Password" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <PasswordBox x:Name="pwspassword" Margin="0,0,10,20" Height="35" Width="300"  ></PasswordBox>
                        <!--email-->
                        <TextBlock Text="Email" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <TextBox x:Name="txtemail" Width="300" Height="35" Margin="0,0,10,20"></TextBox>
                        <!--dob-->
                        <TextBlock Text="DOB" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <TextBox x:Name="txtdob" Width="300" Height="35" Margin="0,0,10,20"></TextBox>
                        <!--Gender-->
                        <TextBlock Text="Gender" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Male" Margin="80,0,0,0"></RadioButton>
                            <RadioButton Content="Female" Margin="20,0,0,0"></RadioButton>
                            <RadioButton Content="Others" Margin="20,0,0,0"></RadioButton>
                        </StackPanel>
                       <!--contact details-->
                        <TextBlock Text="Mobile Number" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <TextBox x:Name="txtmobilenumber" Width="300" Height="35" Margin="0,0,10,20"></TextBox>
                      <!--address-->
                        <TextBlock Text="Address" FontSize="12" Margin="10"  Foreground="Black"></TextBlock>
                        <TextBox x:Name="txtaddress" Width="300" Height="35" Margin="0,0,10,20"></TextBox>
                        <!--Button for Registration-->
                        <Button Content="Register" Margin="0,0,10,20" x:Name="btnreg" Click="btnreg_Click" Height="35" Width="100" Foreground="Black" Background="CadetBlue"></Button>
                        <!--switch account-->
                        <TextBlock Text="Already have an account ? click here to login" FontSize="10" Margin="110,0,0,10"  Foreground="Gray"></TextBlock>


                    </StackPanel>
                </TabItem>
            </TabControl>

        </Border>
    </Grid>
</Window>
